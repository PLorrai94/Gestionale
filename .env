# =============================================================================
# Gestionale — Docker Compose Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before running deploy.sh
#
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================================

# --- Oracle Database ---
ORACLE_PASSWORD=SYSTEM                # SYS / SYSTEM password for Oracle XE

# --- Application DB passwords (one per microservice) ---
GESTIONALE_OWNER_PASSWORD=GESTIONALE_PASS      # GESTIONALE_OWNER schema (Flyway migrations)
SECURITY_DB_PASSWORD=SECURITYAPP           # security-service datasource
MANAGEMENT_DB_PASSWORD=MANAGEMENTPASS         # management-service datasource
BATCH_DB_PASSWORD=yourStrongPassword!              # batch-service datasource

# --- JWT ---
JWT_SECRET_KEY=IlIfQ97arjQ2mOqX+X9qiUpxczSunTBF2VCcZdjkN5B2q0GHc0Q01KypE+fTdcIYk/VZG/ULQV4ikSK5Dax0AQ==                 # Shared HMAC key used by all services

# --- Spring profile (optional) ---
# Use 'local' only when running services outside Docker (e.g. from IDE).
# Docker containers use the default application.yml which has correct Docker hostnames.
SPRING_PROFILES_ACTIVE=default

# --- Ports (defaults match application.yml) ---
EUREKA_PORT=8761
GATEWAY_PORT=8080
SECURITY_PORT=8081
MANAGEMENT_PORT=8082
BATCH_PORT=8083
ORACLE_PORT=1521
ANGULAR_PORT=4200
